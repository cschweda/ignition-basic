10 REM GOSUB AND RETURN: A TINY BANK ACCOUNT
20 B = 100
30 GOSUB 1000
40 A = 25: GOSUB 2000: GOSUB 1000
50 A = 40: GOSUB 3000: GOSUB 1000
60 A = 500: GOSUB 3000: GOSUB 1000
70 PRINT "GOODBYE"
80 END
1000 REM --- SHOW THE BALANCE ---
1010 PRINT "BALANCE: "; B
1020 RETURN
2000 REM --- DEPOSIT A ---
2010 B = B + A
2020 PRINT "DEPOSITED "; A
2030 RETURN
3000 REM --- WITHDRAW A, IF THE MONEY IS THERE ---
3010 IF A > B THEN PRINT "CAN'T WITHDRAW "; A: RETURN
3020 B = B - A
3030 PRINT "WITHDREW "; A
3040 RETURN
