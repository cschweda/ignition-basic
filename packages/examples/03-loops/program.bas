10 REM FOR AND NEXT: COUNTING, STEPPING AND NESTING
20 PRINT "UP:";
30 FOR I = 1 TO 5
40   PRINT " "; I;
50 NEXT I
60 PRINT
70 PRINT "AFTER THE LOOP, I IS "; I
80 PRINT "DOWN BY 2:";
90 FOR I = 10 TO 1 STEP -2
100   PRINT " "; I;
110 NEXT I
120 PRINT
130 PRINT "NOW I IS "; I
140 PRINT "QUARTERS:";
150 FOR X = 0 TO 1 STEP 0.25
160   PRINT " "; X;
170 NEXT X
180 PRINT
190 REM THE TEST COMES FIRST, SO THIS LOOP RUNS ZERO TIMES
200 FOR I = 10 TO 1
210   PRINT "NEVER PRINTED"
220 NEXT I
230 PRINT "ZERO TRIPS, AND I IS "; I
240 REM NESTED LOOPS MAKE A TIMES TABLE
250 FOR R = 1 TO 3
260   FOR C = 1 TO 4
270     PRINT TAB(C * 5 - 5); R * C;
280   NEXT C
290   PRINT
300 NEXT R
310 REM ONE NEXT CAN CLOSE TWO LOOPS, INNERMOST FIRST
320 PRINT "PAIRS:";
330 FOR A = 1 TO 2: FOR B = 1 TO 2
340   PRINT " "; A; "-"; B;
350 NEXT B, A
360 PRINT
370 END
