10 REM A TOUR OF THE STRING FUNCTIONS
20 S$ = "Hello, World"
30 PRINT S$; " HAS "; LEN(S$); " CHARACTERS"
40 PRINT "LEFT$(S$, 5) IS "; LEFT$(S$, 5)
50 PRINT "RIGHT$(S$, 5) IS "; RIGHT$(S$, 5)
60 PRINT "MID$(S$, 3, 3) IS "; MID$(S$, 3, 3)
70 PRINT "MID$(S$, 8) IS "; MID$(S$, 8)
80 PRINT "THE FIRST O IS AT "; INSTR(S$, "o"); ", THE NEXT AT "; INSTR(6, S$, "o")
90 PRINT "NO X: "; INSTR(S$, "X")
100 PRINT UCASE$(S$); " / "; LCASE$(S$)
110 N$ = STR$(2.5 * 4)
120 PRINT "STR$ GIVES "; N$; ", AND VAL GIVES IT BACK: "; VAL(N$) + 1
130 PRINT "VAL STOPS AT THE FIRST NON-NUMBER: "; VAL("3.5 APPLES")
140 PRINT "CHR$(65) IS "; CHR$(65); ", AND THE LETTER AFTER IT IS "; CHR$(ASC("A") + 1)
150 PRINT "["; TRIM$("   TRIMMED   "); "]"
160 PRINT STRING$(10, "*"); SPACE$(3); STRING$(3, 45)
170 REM MID$ AS A STATEMENT OVERWRITES IN PLACE
180 T$ = S$
190 MID$(T$, 8, 5) = "Earth"
200 PRINT T$
210 PRINT "AN EMOJI IS "; LEN("😀"); " CHARACTER"
220 END
