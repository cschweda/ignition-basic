10 REM RND IS REPEATABLE: THE SAME SEED GIVES THE SAME NUMBERS
20 PRINT "UNSEEDED, RND(1) GIVES:"
30 FOR I = 1 TO 3: PRINT RND(1): NEXT I
40 PRINT "RND(0) REPEATS THE LAST ONE: "; RND(0)
50 RANDOMIZE 42
60 PRINT "TEN DICE AFTER RANDOMIZE 42:";
70 FOR I = 1 TO 10: PRINT " "; RND(6);: NEXT I
80 PRINT
90 RANDOMIZE -1
100 PRINT "AFTER RANDOMIZE -1:"
110 FOR I = 1 TO 3: PRINT RND(1): NEXT I
120 RANDOMIZE 7
130 PRINT "RANDOMIZE 7 PICKS "; RND(100); " FOR THE GUESSING GAME"
140 RANDOMIZE 42
150 PRINT "RANDOMIZE 42 AGAIN GIVES THE SAME FIRST DIE: "; RND(6)
160 END
