10 REM ARRAYS: DIM, TWO DIMENSIONS, AND AN IMPLICIT DIM
20 DIM SQUARES(5)
30 FOR I = 0 TO 5
40   SQUARES(I) = I * I
50 NEXT I
60 PRINT "SQUARES:";
70 FOR I = 0 TO 5: PRINT " "; SQUARES(I);: NEXT I
80 PRINT
90 REM A 3 BY 3 GRID
100 DIM GRID$(2, 2)
110 FOR R = 0 TO 2
120   FOR C = 0 TO 2
130     GRID$(R, C) = "."
140   NEXT C
150 NEXT R
160 GRID$(1, 1) = "X": GRID$(0, 2) = "O"
170 FOR R = 0 TO 2
180   PRINT GRID$(R, 0); GRID$(R, 1); GRID$(R, 2)
190 NEXT R
200 REM SCORES HAS NO DIM, SO IT GETS 0 TO 10 AND THE INDEX WARNS ABOUT IT
210 SCORES(10) = 99
220 PRINT "SCORES(10) IS "; SCORES(10); " AND SCORES(3) IS "; SCORES(3)
230 END
