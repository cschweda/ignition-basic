10 REM HELLO, IGNITION BASIC: A TOUR OF PRINT
20 PRINT "HELLO, WORLD!"
30 PRINT
40 REM A SEMICOLON PRINTS ITEMS SIDE BY SIDE
50 PRINT "ONE"; "TWO"; "THREE"
60 REM A COMMA MOVES TO THE NEXT 16-COLUMN ZONE
70 PRINT "NAME", "AGE", "CITY"
80 PRINT "ADA", 36, "LONDON"
90 PRINT "A VERY LONG NAME", "!"
100 REM TAB(N) MOVES TO COLUMN N, COUNTING FROM 0
110 PRINT "X"; TAB(10); "Y"; TAB(5); "Z"
120 PRINT TAB(4); "INDENTED"
130 REM A TRAILING SEMICOLON KEEPS THE LINE OPEN
140 PRINT "LOADING";
150 PRINT "...";
160 PRINT " DONE"
170 PRINT
180 REM NUMBERS PRINT WITH NO PADDING, TO 15 DIGITS
190 PRINT "3 IS "; 3; ", MINUS 3 IS "; -3
200 PRINT "1/3 = "; 1 / 3
210 PRINT "0.1 + 0.2 = "; 0.1 + 0.2
220 PRINT "2^53 = "; 2 ^ 53
230 PRINT "2^70 = "; 2 ^ 70
240 PRINT "TINY: "; 1.5E-8
250 PRINT "TOO BIG: "; 1E308 * 10
260 END
